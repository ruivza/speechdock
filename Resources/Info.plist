<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>$(SPEECHDOCK_DISPLAY_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>$(SPEECHDOCK_DISPLAY_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>SpeechDock</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>SpeechDock needs microphone access to record your voice for transcription.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>SpeechDock uses speech recognition for real-time transcription.</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>SpeechDock needs screen recording access for OCR and system/app audio capture.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Yoichiro Hasebe. All rights reserved.</string>
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- AppleScript Support -->
    <key>NSAppleScriptEnabled</key>
    <true/>
    <key>OSAScriptingDefinition</key>
    <string>SpeechDock.sdef</string>

    <!-- Sparkle Auto-Update Configuration -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/ruivza/speechdock/main/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>A8eXgN+wvWLXQ4mfhitO/XuL9hXIxmAEcNCx+eB2yrU=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUEnableInstallerLauncherService</key>
    <true/>
</dict>
</plist>
